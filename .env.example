# ---- AI (used when "Pemeriksaan AI" is on, the default) ----
# Provider: "openrouter" or "anthropic". When unset, the first provider with a
# key is used (OpenRouter, then Anthropic). With no key, AI checks are skipped.
AI_PROVIDER=

# OpenRouter (https://openrouter.ai/keys). Model defaults to anthropic/claude-haiku-4.5.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Anthropic direct. Model defaults to claude-haiku-4-5.
CLAUDE_API_KEY=
ANTHROPIC_MODEL=

# ---- Storage (leaderboard + re-download of uploads) ----
# Both are needed; without them the app checks files without keeping them.
# On Vercel: connect a *private* Blob store and a Neon database to the project,
# then `vercel env pull .env.local` for local dev.
DATABASE_URL=
# Private Blob uses OIDC + BLOB_STORE_ID on Vercel; locally a read-write token also works.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
